# GCP / Data Lake / Warehouse
GCP_PROJECT_ID="your-gcp-project"
GCS_BUCKET="your-data-lake-bucket"
BQ_DATASET="tea_coffee_analytics"

# BigQuery raw table (schema created by dbt/landing load)
BQ_RAW_TABLE="tea_vs_coffee_global_final_raw"

# Airflow dataset location
# Local path to the provided CSV (used by the DAG upload task + dashboard fallback).
DATASET_LOCAL_PATH="data/tea_vs_coffee_global_final.csv"

# Service account credentials (service account JSON)
# For local dev: point to a JSON file on your machine.
GOOGLE_APPLICATION_CREDENTIALS="C:\path\to\service-account.json"

# Ingestion behavior
PIPELINE_OWNER="student"

